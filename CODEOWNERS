# microtel CODEOWNERS
#
# This file controls automatic review-request assignment for PRs.
# Ownership is layered: more specific rules later in the file override
# earlier ones. The default at the top covers anything not explicitly
# claimed below.
#
# ----------------------------------------------------------------------
# Initial state: solo project. The default owner reviews everything.
# As the project grows, replace the default owner per directory and add
# additional reviewers as a space-separated list:
#
#     /src/wire/grpc/      @grpc-track-owner @backup-reviewer
#
# ----------------------------------------------------------------------

# Default — covers everything not explicitly claimed below
*                                       @chanderraja

# ----------------------------------------------------------------------
# Architecture and design documents (M0 deliverables)
# ----------------------------------------------------------------------

/docs/architecture.md                   @chanderraja
/docs/threading-model.md                @chanderraja
/docs/memory-model.md                   @chanderraja
/docs/error-model.md                    @chanderraja
/docs/interfaces.md                     @chanderraja
/docs/coding-standards.md               @chanderraja
/docs/sequences/                        @chanderraja
/docs/icps/                             @chanderraja

# ----------------------------------------------------------------------
# Public API headers — interface changes are high-impact
# ----------------------------------------------------------------------

/include/microtel/                      @chanderraja

# ----------------------------------------------------------------------
# Track-owned source directories (per spec §13.1)
# Each track gets its own CODEOWNERS line as the project grows.
# ----------------------------------------------------------------------

# Track A — Trace SDK
/src/api/                               @chanderraja
/src/sdk/                               @chanderraja

# Track B — OTLP/HTTP wire codec
/src/wire/http/                         @chanderraja

# Track C — OTLP/gRPC wire codec (the hardest piece)
/src/wire/grpc/                         @chanderraja

# Track D — Transport (foundational)
/src/transport/                         @chanderraja

# Track E — Config
/src/common/config/                     @chanderraja

# Track F — OTLP encoder (foundational; only file touching upb directly)
/src/wire/encoder/                      @chanderraja

# Common code (logging, errors, RAII wrappers, limits)
/src/common/                            @chanderraja

# ----------------------------------------------------------------------
# Build and packaging
# ----------------------------------------------------------------------

/CMakeLists.txt                         @chanderraja
/cmake/                                 @chanderraja
/.clang-tidy                            @chanderraja
/.clang-format                          @chanderraja
/ci/                                    @chanderraja
/.github/workflows/                     @chanderraja

# Packaging (deb/rpm/cibuildwheel)
/packaging/                             @chanderraja

# ----------------------------------------------------------------------
# Python bindings
# ----------------------------------------------------------------------

/python/                                @chanderraja
/python/bindings/                       @chanderraja

# ----------------------------------------------------------------------
