#
# microtel_leaf_target_runner(<name> BACKEND <upb|nanopb> LIB <leaf target>
#                             PLATFORM <hosted|cortex-m> [LINKER_SCRIPT <file>]
#                             [MEASURE_STACK] [DEFINES <...>])
#
# One build of the target test runner (leaf_target_test.c) against one leaf
# archive. The golden vectors are compiled in, since a bare-metal target has no
# file system. Included by tests/unit/leaf/ (the host build, run by ctest) and
# by this directory's CMakeLists.txt (the cross builds).

set(MICROTEL_LEAF_TARGET_DIR ${CMAKE_CURRENT_LIST_DIR})
get_filename_component(MICROTEL_LEAF_TARGET_REPO ${CMAKE_CURRENT_LIST_DIR}/../../.. ABSOLUTE)

# Writes <binary dir>/leaf_target_golden.c from tests/leaf/vectors/*.bin, once
# per directory, and returns its path.
function(microtel_leaf_target_golden out_var)
    set(out ${CMAKE_CURRENT_BINARY_DIR}/leaf_target_golden.c)
    file(GLOB bins ${MICROTEL_LEAF_TARGET_REPO}/tests/leaf/vectors/*.bin)
    list(SORT bins)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${bins})
    set(arrays "")
    set(table "")
    foreach(bin IN LISTS bins)
        get_filename_component(stem ${bin} NAME_WE)
        file(READ ${bin} hex HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(APPEND arrays "static const uint8_t k_${stem}[] = {${bytes}};\n")
        string(APPEND table "    {\"${stem}\", k_${stem}, sizeof(k_${stem})},\n")
    endforeach()
    list(LENGTH bins count)
    file(CONFIGURE OUTPUT ${out} CONTENT
"/* Generated by tests/leaf/target/leaf_target.cmake from tests/leaf/vectors/. */
#include \"leaf_target_golden.h\"

${arrays}
const leaf_target_golden leaf_target_goldens[] = {
${table}};

const size_t leaf_target_golden_count = ${count}u;
" @ONLY)
    set(${out_var} ${out} PARENT_SCOPE)
endfunction()

function(microtel_leaf_target_runner name)
    cmake_parse_arguments(LT "MEASURE_STACK" "BACKEND;LIB;PLATFORM;LINKER_SCRIPT" "DEFINES" ${ARGN})
    microtel_leaf_target_golden(golden)
    if(LT_PLATFORM STREQUAL "cortex-m")
        set(platform_source ${MICROTEL_LEAF_TARGET_DIR}/leaf_target_cortex_m.c)
    else()
        set(platform_source ${MICROTEL_LEAF_TARGET_DIR}/leaf_target_hosted.c)
    endif()
    add_executable(${name}
        ${MICROTEL_LEAF_TARGET_DIR}/leaf_target_test.c
        ${platform_source}
        ${MICROTEL_LEAF_TARGET_REPO}/tests/leaf/vectors/leaf_vectors.c
        ${golden})
    target_include_directories(${name} PRIVATE
        ${MICROTEL_LEAF_TARGET_DIR}
        ${MICROTEL_LEAF_TARGET_REPO}/tests/leaf/vectors)
    target_link_libraries(${name} PRIVATE ${LT_LIB})
    string(TOUPPER ${LT_BACKEND} backend_upper)
    target_compile_definitions(${name} PRIVATE
        LEAF_TARGET_BACKEND_${backend_upper}=1
        LEAF_TARGET_BACKEND_NAME="${LT_BACKEND}"
        ${LT_DEFINES})
    if(LT_MEASURE_STACK)
        target_compile_definitions(${name} PRIVATE LEAF_TARGET_MEASURE_STACK=1)
    endif()
    # C11 like the leaf. Not -pedantic-errors: the Cortex-M platform file needs
    # inline assembly and section attributes for its vector table.
    set_target_properties(${name} PROPERTIES
        C_STANDARD 11
        C_STANDARD_REQUIRED ON
        C_EXTENSIONS OFF)
    target_compile_options(${name} PRIVATE -Wall -Wextra -Wvla -Werror)
    if(LT_LINKER_SCRIPT)
        get_filename_component(script_dir ${LT_LINKER_SCRIPT} DIRECTORY)
        target_link_options(${name} PRIVATE
            -nostartfiles -T${LT_LINKER_SCRIPT} -L${script_dir}
            -Wl,--gc-sections -Wl,-Map=${CMAKE_CURRENT_BINARY_DIR}/${name}.map)
        set_property(TARGET ${name} APPEND PROPERTY LINK_DEPENDS
            ${LT_LINKER_SCRIPT} ${MICROTEL_LEAF_TARGET_DIR}/cortex_m.ld)
    endif()
endfunction()
